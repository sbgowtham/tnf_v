        {
          "title": {
            "en": "Calculate earnings",
            "ta": "Earnings calculate pannuvom",
            "hi": "Earnings calculate karte hain",
            "te": "Earnings calculate cheddam"
          },
          "sql": "SELECT d.driver_id, d.driver_name, d.city, SUM(t.fare) AS total_earnings\nFROM drivers d\nJOIN trips t ON d.driver_id = t.driver_id\nGROUP BY d.driver_id, d.driver_name, d.city;",
          "explain": {
            "en": [
              "SUM → total fare add pannum",
              "GROUP BY → driver-wise grouping",
              "AS → column rename",
              "Each driver → one row"
