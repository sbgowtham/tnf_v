            "te": "Drivers mariyu trips ni join cheddam"
          },
          "sql": "SELECT d.driver_id, d.driver_name, d.city, t.fare\nFROM drivers d\nJOIN trips t ON d.driver_id = t.driver_id;",
          "explain": {
            "en": [
              "SELECT → output columns choose pannum",
              "d.driver_id → drivers table id",
              "t.fare → trips table fare",
