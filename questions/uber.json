        {
          "title": {
            "en": "Top 3 per city",
            "ta": "Top 3 drivers eduthuvom",
            "hi": "Top 3 drivers nikalte hain",
            "te": "Top 3 drivers kanukundam"
          },
          "sql": "SELECT * FROM (\n SELECT d.driver_id, d.driver_name, d.city,\n SUM(t.fare) AS total_earnings,\n ROW_NUMBER() OVER (PARTITION BY d.city ORDER BY SUM(t.fare) DESC) rn\n FROM drivers d\n JOIN trips t ON d.driver_id = t.driver_id\n GROUP BY d.driver_id, d.driver_name, d.city\n) x WHERE rn <= 3;",
          "explain": {
            "en": [
